# ---------------------------------------------------------------------------
# EcoVerify: environment variables (copy to .env and fill in)
# ---------------------------------------------------------------------------

# Postgres connection string (Supabase: Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecoverify
# "disable" for a local Postgres without SSL. Leave empty for Supabase.
DATABASE_SSL=
# Optional: CA certificate (PEM, "\n" escaped) to verify the database certificate
DATABASE_SSL_CA=

# File storage. When both are set, photos/media go to Supabase Storage (recommended
# in production). Otherwise files are stored on disk in UPLOAD_DIR.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
UPLOAD_DIR=./storage/uploads

# Production domain(s) allowed to call Server Actions, comma separated
SERVER_ACTIONS_ALLOWED_ORIGINS=

# FONE wallet verification: native FONE address (64 hex chars starting with "f") of the
# EcoVerify wallet that receives the ownership-proof transfers (1.01–9.99 FONE each).
# Use a dedicated wallet, not the one holding the reward pool. Empty = verification closed.
FONE_TREASURY_ADDRESS=
# Block explorer used for links (address/<addr>, tx/<hash>)
FONE_EXPLORER_URL=https://fone.dev

# Optional: GIF search in the community chat
NEXT_PUBLIC_GIPHY_API_KEY=

# Android build: HTTPS URL of the deployed web app
CAPACITOR_SERVER_URL=

# Seed (npm run db:seed): password for demo users
SEED_PASSWORD=
