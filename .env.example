# ---------------------------------------------------------------------------
# EcoVerify: environment variables (copy to .env and fill in)
# ---------------------------------------------------------------------------

# Postgres connection string (Supabase: Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecoverify
# "disable" for a local Postgres without SSL. Leave empty for Supabase.
DATABASE_SSL=
# Optional: CA certificate (PEM, "\n" escaped) to verify the database certificate
DATABASE_SSL_CA=

# File storage. When both are set, photos/media go to Supabase Storage (recommended
# in production). Otherwise files are stored on disk in UPLOAD_DIR.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
UPLOAD_DIR=./storage/uploads

# Production domain(s) allowed to call Server Actions, comma separated
SERVER_ACTIONS_ALLOWED_ORIGINS=
# Development only: extra hosts allowed to load the dev server (127.0.0.1 and Codespaces already are)
DEV_ALLOWED_ORIGINS=

# FONE wallet verification: native FONE address (64 hex chars starting with "f") of the
# EcoVerify wallet that receives the ownership-proof transfers (1.01–9.99 FONE each).
# Use a dedicated wallet, not the one holding the reward pool. Empty = verification closed.
FONE_TREASURY_ADDRESS=
# Block explorer used for links (address/<addr>, tx/<hash>)
FONE_EXPLORER_URL=https://fone.dev
# Optional: public address of the wallet that pays the rewards (shown on /transparencia so
# anyone can check its balance and transfers in the explorer). Not the verification wallet above.
FONE_REWARDS_WALLET=

# Transactional e-mail (account confirmation, password reset) through https://resend.com.
# EMAIL_FROM must use a domain verified in Resend. APP_URL is the public URL used in the links
# (never derived from the request). Without these, production sends nothing and does not
# require e-mail confirmation; development prints the e-mails in the server log.
RESEND_API_KEY=
EMAIL_FROM="EcoVerify <nao-responda@seu-dominio.com>"
APP_URL=https://seu-dominio.com

# LGPD: who is responsible for the data and the privacy contact, shown in /termos and /privacidade
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=

# Automatic photo verification (docs/VERIFICACAO_IA.md). Free key: https://aistudio.google.com/apikey
# Empty = AI off (proofs go to moderators as before; the near-duplicate photo check still runs).
# Free tier: Google may use the content for training, and there is a daily quota. Use a paid
# key (or another provider) before the public launch.
# Keys from AI Studio start with "AQ." (old "AIza" keys stopped being accepted in Sept 2026).
GEMINI_API_KEY=
# Model with image input. "-latest" aliases are updated by Google; pin an exact name if you prefer.
GEMINI_MODEL=gemini-flash-lite-latest
# Only for tests/proxies
GEMINI_API_BASE_URL=

# Regional missions (docs/MISSOES_REGIONAIS.md). When a city has fewer than 3 missions, the server
# looks for beaches, parks and recycling points on OpenStreetMap (Overpass API) and creates
# points-only missions for an admin to review. "off" disables it.
AUTO_MISSIONS_OSM=on
# Public instance by default (fair use). Point to your own Overpass for heavy use.
OVERPASS_API_URL=

# SaaS / sales (all optional)
# Pix key that receives the organization plans (CPF/CNPJ, e-mail, phone or random key).
# Without it the Plan tab shows "talk to us" instead of a Pix QR code.
PIX_KEY=
# Receiver name and city printed in the Pix code (no accents needed, max 25/15 characters)
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=Recife
# "Talk to us" link in the Plan tab: WhatsApp (e.g. 5581999999999) or, without it, an e-mail
SALES_WHATSAPP=
SALES_EMAIL=

# Optional: GIF search in the community chat
NEXT_PUBLIC_GIPHY_API_KEY=

# Android build: HTTPS URL of the deployed web app
CAPACITOR_SERVER_URL=

# Seed (npm run db:seed): password for demo users
SEED_PASSWORD=
# Show the seed accounts on the login page of a production build (demo servers only)
SHOW_SEED_ACCOUNTS=

# Moderation is admin-only by default. "true" lets users with the "moderator" role review proofs
# and give yellow cards (red cards, suspensions, bans and FONE stay admin-only).
MODERATORS_ENABLED=false

# Owner account(s), comma separated. The account becomes admin once the e-mail is confirmed (or with
# `npm run admin:promote -- email`), can't be demoted/banned from the panel and, while this is set,
# only these e-mails can be admins. Never put passwords here.
ADMIN_EMAILS=

# Seed accounts (@ecoverify.dev, password from db:seed) never sign in in production unless "true".
ALLOW_SEED_ACCOUNTS=false

# Optional reverse image search (Google Cloud Vision "Web Detection"). Needs a Google Cloud project
# with billing enabled; the first 1,000 photos/month are free (then US$ 3.50 per 1,000).
# VISION_MONTHLY_LIMIT stops the searches for the month at this number (default 1000 = free tier).
GOOGLE_VISION_API_KEY=
VISION_MONTHLY_LIMIT=1000

# Verification window (proofs are checked over up to 24 h; see src/lib/verification.ts).
# Optional: a scheduler calls GET /api/cron/verify every 10-15 min with "Authorization: Bearer <CRON_SECRET>".
# Without it, the same work runs whenever the moderation or "My Submissions" pages are opened.
CRON_SECRET=
